<Window x:Class="Mazandasht.Presentation.Import.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مرکز واردسازی — مازندشت"
        Width="1120" Height="780"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource PersianFont}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Design/Theme.v2.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="مرکز واردسازی"
                   Style="{StaticResource SectionTitleStyle}" FontSize="24"/>

        <!-- ======================== Step 1: choose ======================== -->
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="۱ — فایل و قالب" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ChooseFileButton" Content="انتخاب فایل اکسل"
                                Style="{StaticResource GlassButtonStyle}"
                                Click="ChooseFileButton_Click"/>
                        <ComboBox x:Name="TemplatePicker" Width="330" Margin="8,4,0,4"
                                  SelectionChanged="TemplatePicker_SelectionChanged"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="Display"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="0" Grid.Column="1" x:Name="PreviewButton"
                        Content="بررسی فایل" VerticalAlignment="Bottom"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="PreviewButton_Click" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="FileSummaryText"
                           Style="{StaticResource MutedLabelStyle}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- ======================== Steps 2-3 ======================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Preview: what WOULD be written -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,6,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="۲ — پیش‌نمایش (هنوز چیزی ثبت نشده)"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandDarkBrush}"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{StaticResource SuccessWashBrush}"
                                    CornerRadius="999" Padding="9,3" Margin="0,0,8,0">
                                <TextBlock x:Name="ValidCountText" FontSize="{StaticResource FontMicro}"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                            <Border Background="{StaticResource DangerWashBrush}"
                                    CornerRadius="999" Padding="9,3">
                                <TextBlock x:Name="InvalidCountText" FontSize="{StaticResource FontMicro}"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="PreviewGrid" Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="سطر" Binding="{Binding SourceRow}" Width="60"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="80"/>
                            <DataGridTextColumn Header="پیام" Binding="{Binding Summary}" Width="*"/>
                            <DataGridTextColumn Header="فیلدهای خالی" Binding="{Binding Blanks}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Commit + history -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="۳ — ثبت" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource MutedLabelStyle}" TextWrapping="Wrap"
                                   Text="ثبت، سند می‌سازد و کد دسته می‌دهد. تا این دکمه را نزنید هیچ ردیفی نوشته نمی‌شود."/>
                        <Button x:Name="CommitButton" Content="ثبت در پایگاه داده"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0" IsEnabled="False"
                                Click="CommitButton_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="6,12,6,6">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                            <TextBlock Text="تاریخچه دسته‌ها" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       DockPanel.Dock="Right"/>
                            <Button Content="بازخوانی" DockPanel.Dock="Left"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Padding="10,4" Click="RefreshBatches_Click"/>
                        </DockPanel>

                        <ListBox x:Name="BatchList" BorderThickness="0"
                                 Background="Transparent" Margin="0,8,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="10" Padding="10" Margin="0,0,0,6"
                                            BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Code}"
                                                           FontSize="{StaticResource FontSmall}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           DockPanel.Dock="Right"/>
                                                <TextBlock Text="{Binding StatusFa}"
                                                           FontSize="{StaticResource FontMicro}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           DockPanel.Dock="Left"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="{StaticResource FontMicro}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <DockPanel LastChildFill="False" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Counts}"
                                                           FontSize="{StaticResource FontMicro}"
                                                           Foreground="{StaticResource FaintTextBrush}"
                                                           DockPanel.Dock="Right"/>
                                                <Button Content="برگشت"
                                                        DockPanel.Dock="Left"
                                                        Style="{StaticResource GlassButtonStyle}"
                                                        Padding="8,3"
                                                        FontSize="{StaticResource FontMicro}"
                                                        Tag="{Binding}"
                                                        Click="Rollback_Click"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusText"
                   Style="{StaticResource MutedLabelStyle}"
                   Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
