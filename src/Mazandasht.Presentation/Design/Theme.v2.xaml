<!--
  MAZANDASHT — Design system v2 (Agent B)

  Rules this file exists to enforce:

  1. NO hex colour appears in a page. Every colour is a token here. A scattered
     `#F2F5F3` means the theme cannot be changed without hunting through XAML.
  2. Brand #075E1E and the bank operation colours come verbatim from spec ch.12.
     Anything not in the spec is marked `DERIVED` with its reason.
  3. No external dependency. This runs offline on Windows 8.1 x64 / .NET 4.8,
     so charts are Path/Polyline and fonts are system fonts. A NuGet package is
     an installation risk the owner cannot debug.
  4. Glass is *controlled*: semi-transparent, never blurred past readability.
     The owner reads numbers on this screen, not a mood.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">

    <!-- ====================================================================
         Colour tokens — brand (spec ch.12)
         ==================================================================== -->
    <Color x:Key="BrandColor">#075E1E</Color>
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}"/>
    <SolidColorBrush x:Key="BrandLightBrush" Color="#0E7A2A"/>
    <SolidColorBrush x:Key="BrandDarkBrush" Color="#043F14"/>
    <!-- DERIVED: a wash of the brand for selected rows and chart fills. -->
    <SolidColorBrush x:Key="BrandWashBrush" Color="#12075E1E"/>
    <SolidColorBrush x:Key="BrandTintBrush" Color="#E8F0E9"/>

    <!-- ====================================================================
         Colour tokens — surfaces
         ==================================================================== -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2F5F3"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7FAF8"/>
    <SolidColorBrush x:Key="ChromeBrush" Color="#E8EDE9"/>
    <SolidColorBrush x:Key="GlassBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="GlassStrongBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#33000000"/>

    <!-- Glass surfaces that sit ON the brand colour (navigation rail, second
         monitor). White at low alpha, because anything tinted green over
         #075E1E turns muddy. These exist as tokens so no page writes a raw
         hex; the strict mode of tools/check_xaml.py fails if one does. -->
    <SolidColorBrush x:Key="GlassOnBrandBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="GlassOnBrandRaisedBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="HairlineOnBrandBrush" Color="#22FFFFFF"/>

    <!-- ====================================================================
         Colour tokens — text
         ==================================================================== -->
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#666666"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="OnBrandTextBrush" Color="#FFFFFF"/>
    <!-- DERIVED: readable on #075E1E, from spec ch.12's own header usage. -->
    <SolidColorBrush x:Key="OnBrandMutedBrush" Color="#CDE8D2"/>

    <!-- ====================================================================
         Colour tokens — status and meaning
         ==================================================================== -->
    <SolidColorBrush x:Key="ApprovedBrush" Color="#454545"/>
    <SolidColorBrush x:Key="ApprovedWashBrush" Color="#EFEFEF"/>
    <!-- DERIVED: not in the spec, but a review-queue item must be visibly
         distinct from an approved one, and grey is already taken. -->
    <SolidColorBrush x:Key="PendingBrush" Color="#8A6D1F"/>
    <SolidColorBrush x:Key="PendingWashBrush" Color="#FFF2CC"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#A61B1B"/>
    <SolidColorBrush x:Key="DangerWashBrush" Color="#FCE4D6"/>
    <!-- Warning is deliberately NOT Danger: a report that cannot be built
         because the owner has not defined it yet is not an error, and using
         red for it would train the owner to ignore red. Same amber as Pending
         because it means the same thing: blocked on a decision. -->
    <SolidColorBrush x:Key="WarningBrush" Color="#8A6D1F"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7A34"/>
    <SolidColorBrush x:Key="SuccessWashBrush" Color="#E2F0D9"/>

    <!-- ====================================================================
         Colour tokens — bank operations (spec ch.12, verbatim)
         ==================================================================== -->
    <SolidColorBrush x:Key="OpDepositBrush" Color="#E2F0D9"/>
    <SolidColorBrush x:Key="OpWithdrawalBrush" Color="#FCE4D6"/>
    <SolidColorBrush x:Key="OpFeeBrush" Color="#E4DFEC"/>
    <SolidColorBrush x:Key="OpTransferBrush" Color="#E7E6E6"/>
    <SolidColorBrush x:Key="OpChequePayBrush" Color="#FFF2CC"/>
    <SolidColorBrush x:Key="OpChequeRecBrush" Color="#DDEBF7"/>

    <!-- ====================================================================
         Typography
         Segoe UI ships on every Windows 8.1 and covers Persian. Tahoma is the
         fallback for the odd locale where it does not, Arial the last resort.
         ==================================================================== -->
    <FontFamily x:Key="PersianFont">Segoe UI, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="NumericFont">Segoe UI, Tahoma</FontFamily>

    <sys:Double x:Key="FontDisplay">28</sys:Double>
    <sys:Double x:Key="FontTitle">19</sys:Double>
    <sys:Double x:Key="FontSubtitle">14</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontSmall">11.5</sys:Double>
    <sys:Double x:Key="FontMicro">10.5</sys:Double>

    <!-- ====================================================================
         Spacing scale — 4px base. Arbitrary margins are what make an
         interface look assembled rather than designed.
         ==================================================================== -->
    <Thickness x:Key="PadCard">18</Thickness>
    <Thickness x:Key="PadTight">10</Thickness>
    <Thickness x:Key="PadRow">12,8</Thickness>
    <!-- NOTE: CornerRadius is deliberately NOT declared as a resource.
         Unlike Thickness, CornerRadius's element syntax inside a
         ResourceDictionary is not reliable: the XAML parser fails on
         <CornerRadius x:Key="..">14</CornerRadius> in several WPF versions
         because the type exposes no element-content TypeConverter.
         Since this file cannot be compiled here, a construct that only
         *usually* works is not acceptable — the radii are written literally
         below and this comment is the single place the scale is documented:
             14  card / panel
             10  control
             999 pill
    -->

    <!-- ====================================================================
         Shadows — subtle. A heavy drop shadow on every card is the fastest way
         to make a financial tool look like a toy.
         ==================================================================== -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2"
                      Direction="270" Opacity="0.10" Color="#000000"/>
    <DropShadowEffect x:Key="RaisedShadow" BlurRadius="26" ShadowDepth="6"
                      Direction="270" Opacity="0.16" Color="#000000"/>
    <DropShadowEffect x:Key="PillShadow" BlurRadius="12" ShadowDepth="1"
                      Direction="270" Opacity="0.14" Color="#000000"/>

    <!-- ====================================================================
         Glass button — three states that actually look different
         ==================================================================== -->
    <Style x:Key="GlassButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PersianFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background"
                                    Value="{StaticResource GlassStrongBrush}"/>
                            <Setter TargetName="Shell" Property="BorderBrush"
                                    Value="{StaticResource BrandBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Background"
                                    Value="{StaticResource BrandTintBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Solid brand button for the one primary action on a screen. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource OnBrandTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ====================================================================
         KPI card — the unit the dashboard is made of
         ==================================================================== -->
    <Style x:Key="KpiCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="{StaticResource PadCard}"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="{StaticResource PadCard}"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- ====================================================================
         Status pill — approved / pending / danger, one shape three colours
         ==================================================================== -->
    <Style x:Key="StatusPillBaseStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StatusApprovedStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{StaticResource ApprovedWashBrush}"/>
    </Style>
    <Style x:Key="StatusPendingStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{StaticResource PendingWashBrush}"/>
    </Style>
    <Style x:Key="StatusDangerStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{StaticResource DangerWashBrush}"/>
    </Style>

    <!-- ====================================================================
         Readable table — zebra rows, no grid lines fighting the numbers
         ==================================================================== -->
    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="FlowDirection" Value="RightToLeft"/>
        <Setter Property="FontFamily" Value="{StaticResource PersianFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="RowHeight" Value="34"/>
    </Style>

    <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BrandTintBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- ====================================================================
         Navigation rail — the tool surface. Tools are grouped by the work the
         owner does, not by database table.
         ==================================================================== -->
    <Style x:Key="NavButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource OnBrandMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PersianFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSubtitle}"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}" Margin="6,2">
                        <Grid>
                            <Border x:Name="Accent" Width="3" HorizontalAlignment="Right"
                                    Background="Transparent" CornerRadius="2"/>
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#26FFFFFF"/>
                            <Setter TargetName="Accent" Property="Background"
                                    Value="{StaticResource OnBrandTextBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource OnBrandTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================================
         Section heading — one style so every screen has the same rhythm
         ==================================================================== -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PersianFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="MutedLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PersianFont}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
    </Style>

    <!-- Numbers get a direction-neutral font so a minus sign and a thousands
         separator cannot land on the wrong side under RightToLeft. -->
    <Style x:Key="NumberStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumericFont}"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="FontSize" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- ====================================================================
         Converters — the one the framework already ships. A hand-written
         BoolToVisibility would be a third copy of the same four lines.
         ==================================================================== -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- ====================================================================
         Motion — three animations, each under 200ms. More than this slows the
         owner's daily work, which is the opposite of "professional".
         ==================================================================== -->
    <Storyboard x:Key="CardEnter">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.18"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="8" To="0" Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="NumberPulse">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.35" To="1" Duration="0:0:0.16"/>
    </Storyboard>

</ResourceDictionary>
