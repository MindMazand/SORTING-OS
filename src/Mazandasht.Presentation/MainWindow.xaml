<Window x:Class="Mazandasht.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مازندشت" Width="1280" Height="800"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        Background="#F2F5F3">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BrandBrush}" Padding="16,0">
            <DockPanel>
                <TextBlock Text="مازندشت" Foreground="White" FontSize="20"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="سامانه یکپارچه سورتینگ و بازرگانی" Foreground="#CDE8D2"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button x:Name="SecondMonitorButton" Content="نمایشگر دوم"
                        Style="{StaticResource GlassButtonStyle}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Dashboard (no global scroll on the main page — Spec ch. 12) -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="RangeLabel" Grid.Row="0" FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
            <ItemsControl x:Name="KpiItems" Grid.Row="1">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource KpiCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#E8EDE9" Padding="12,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"/>
        </Border>

        <!-- Central quick-add (+) button: opens the operations menu (Spec ch. 13) -->
        <Button x:Name="QuickAddButton" Content="+" Width="64" Height="64"
                FontSize="32" FontWeight="Bold" Foreground="White"
                Background="{StaticResource BrandBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="24" ToolTip="عملیات سریع">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="32">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <ContextMenu x:Name="QuickAddMenu" PlacementTarget="{Binding ElementName=QuickAddButton}">
            <MenuItem Header="باسکول" Tag="WEIGH"/>
            <MenuItem Header="خرید" Tag="PURCHASE"/>
            <MenuItem Header="فروش" Tag="SALES"/>
            <MenuItem Header="سورتینگ" Tag="SORTING"/>
            <MenuItem Header="انبار" Tag="STOCK"/>
            <MenuItem Header="سبد" Tag="BASKET"/>
            <MenuItem Header="بانک" Tag="BANK"/>
            <MenuItem Header="چک" Tag="CHEQUE"/>
            <MenuItem Header="تسویه" Tag="SETTLEMENT"/>
            <MenuItem Header="اشخاص" Tag="PARTY"/>
            <MenuItem Header="کارکنان" Tag="EMPLOYEE"/>
            <MenuItem Header="هزینه" Tag="EXPENSE"/>
            <MenuItem Header="شراکت" Tag="PARTNERSHIP"/>
            <MenuItem Header="اسناد حسابداری" Tag="JOURNAL"/>
        </ContextMenu>
    </Grid>
</Window>
