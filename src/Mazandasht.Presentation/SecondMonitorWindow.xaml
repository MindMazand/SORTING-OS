<Window x:Class="Mazandasht.Presentation.SecondMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نمایشگر دوم - مازندشت" Width="1280" Height="800"
        FlowDirection="RightToLeft" WindowStartupLocation="Manual"
        Background="#0B1F12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="مازندشت — نمایش اطلاعات" Foreground="White" FontSize="28"
                   FontWeight="Bold" Margin="0,0,0,16"/>
        <ItemsControl x:Name="KpiItems" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource KpiCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
