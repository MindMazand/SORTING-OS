<Window x:Class="Mazandasht.Presentation.SecondMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نمایشگر دوم — مازندشت"
        Width="1280" Height="800"
        FlowDirection="RightToLeft" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource BrandDarkBrush}"
        FontFamily="{StaticResource PersianFont}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/Theme.v2.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- A dashboard read from across a room. Sizes are deliberately larger than
         the main window: this screen is not for editing, it is for seeing. -->
    <Grid Margin="36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right">
                <TextBlock Text="مازندشت" FontSize="34" FontWeight="Bold"
                           Foreground="{StaticResource OnBrandTextBrush}"/>
                <TextBlock x:Name="SubtitleText" FontSize="15"
                           Foreground="{StaticResource OnBrandMutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="ExitButton" Content="بازگشت به صفحه اصلی"
                    Style="{StaticResource GlassButtonStyle}"
                    DockPanel.Dock="Left" VerticalAlignment="Top"
                    Background="{StaticResource GlassOnBrandBrush}"
                    Foreground="{StaticResource OnBrandTextBrush}"
                    Click="ExitButton_Click"/>
        </DockPanel>

        <ItemsControl x:Name="KpiItems" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource GlassOnBrandRaisedBrush}"
                            CornerRadius="14" Padding="20" Margin="7"
                            BorderBrush="{StaticResource HairlineOnBrandBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="15"
                                       Foreground="{StaticResource OnBrandMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Value}" FontSize="40"
                                           FontWeight="Bold"
                                           FlowDirection="LeftToRight"
                                           Foreground="{StaticResource OnBrandTextBrush}"/>
                                <TextBlock Text="{Binding Unit}" FontSize="13"
                                           Foreground="{StaticResource OnBrandMutedBrush}"
                                           VerticalAlignment="Bottom" Margin="7,0,0,8"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                       Foreground="{StaticResource PendingWashBrush}"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="13"
                   Foreground="{StaticResource OnBrandMutedBrush}"
                   Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
